# SmartHire AI - Backend Environment Configuration Example
APP_NAME="SmartHire AI"
APP_VERSION="1.0.0"
DEBUG=False
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="your-random-secret-key-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://username:password@ep-your-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Frontend URLs for CORS (comma-separated for multiple origins)
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,https://your-frontend.vercel.app"

# AI Service Credentials
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

# Primary AI provider: "groq" or "gemini"
AI_PROVIDER="groq"
